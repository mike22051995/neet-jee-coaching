# Test environment — used by pytest via TEST_DATABASE_URL.
# This DB is created/dropped by the test suite; never point it at production.
TEST_DATABASE_URL=postgresql+asyncpg://neetjee_user:changeme_in_production@localhost:5432/neetjee_test_db

# JWT — use a separate secret so test tokens can't be used against the dev server
SECRET_KEY=test-secret-key-not-for-production-use-only-in-tests
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_EMAIL=testadmin@coaching.in
ADMIN_PASSWORD=TestAdminPass123!
ADMIN_NAME=Test Admin

ENVIRONMENT=test
DEBUG=true
UPLOAD_DIR=/tmp/neetjee_test_uploads
