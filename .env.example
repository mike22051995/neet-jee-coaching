# ─── Copy this file to .env and fill in your values ──────────────────────────
# NEVER commit .env to git — it contains secrets.

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=neetjee_db
POSTGRES_USER=neetjee_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Full async database URL — Docker Compose sets this automatically from above.
# For local dev without Docker, set it manually:
DATABASE_URL=postgresql+asyncpg://neetjee_user:CHANGE_THIS_STRONG_PASSWORD@localhost:5432/neetjee_db

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Admin Bootstrap ──────────────────────────────────────────────────────────
# Used only during first run to create the initial admin account.
# Change these before first deploy!
ADMIN_EMAIL=admin@yourcoaching.in
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_NAME=Admin

# ─── App Settings ─────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads          # absolute path inside the container
MAX_UPLOAD_SIZE_MB=5

# ─── Test Database (for pytest) ───────────────────────────────────────────────
TEST_DATABASE_URL=postgresql+asyncpg://neetjee_user:CHANGE_THIS_STRONG_PASSWORD@localhost:5432/neetjee_test_db
